//Functions
//-----------------------------------------------------------------------------{

tf_ok_mic  =  timeframe.in_seconds(tf) <= timeframe.in_seconds("5")  
tf_ok_mic_V = 
 timeframe.in_seconds(tf) >= timeframe.in_seconds(botm) and
 timeframe.in_seconds(tf) <= timeframe.in_seconds(topm)

tf_ok      = timeframe.in_seconds(tf) <= timeframe.in_seconds("30")
tf_ok_V    =
 timeframe.in_seconds(tf) >= timeframe.in_seconds(botN) and
 timeframe.in_seconds(tf) <= timeframe.in_seconds(topN)

tf_okD     = timeframe.in_seconds(tf) <= timeframe.in_seconds("180")
tf_okD_V   = 
 timeframe.in_seconds(tf) >= timeframe.in_seconds(botD) and
 timeframe.in_seconds(tf) <= timeframe.in_seconds(topD)

tf_okW     = timeframe.in_seconds(tf) < timeframe.in_seconds("240")
tf_okW_V   = 
 timeframe.in_seconds(tf) >= timeframe.in_seconds(botW) and
 timeframe.in_seconds(tf) <= timeframe.in_seconds(topW)

var tablo = table.new(position = i_pos,columns = 2,rows = 15,frame_color=i_textcolor ,frame_width=1,border_color=i_bgcolor ,border_width=1)


/////////////////////////////////////
add_to_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > num_candles -1
        array.pop(arr)
add_to_array_box(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > 40
        array.pop(arr)        
f_live_sym(_xc0,_xo0,_xh0,_xl0,_xt0,_tf)=>

    var _c1 = 0.0, var _o1 = 0.0 , var _h1 = 0.0, var _l1 = 0.0, var _t1 = 0
    var _c2 = 0.0, var _o2 = 0.0 , var _h2 = 0.0, var _l2 = 0.0, var _t2 = 0 
    var up0 = false , var up1 = false
    var dw0 = false , var dw1 = false
    var _l0t = time , var _h0t = time, var _h1t = time , var _l1t = time   
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
        
    if _xh0 >= _h0
        _h0 := _xh0
        _h0t := time
    if _xl0 <= _l0
        _l0 := _xl0
        _l0t := time
    _c0 := _xc0
    up0 := _c0 > _o0
    dw0 := _c0 < _o0
    if timeframe.change(_tf)
        _c1  :=  _c0[1]
        _o1  :=  _o0[1]
        _h1  :=  _h0[1]
        _l1  :=  _l0[1]
        _t1  :=  _t0[1]
        _c2  :=  _c1[1]
        _o2  :=  _o1[1]
        _h2  :=  _h1[1]
        _l2  :=  _l1[1]
        _t2  :=  _t1[1] 
        up1  :=  up0[1]
        dw1  :=  dw0[1]
        _l1t :=  _l0t[1]
        _h1t :=  _h0t[1]


    [_h2,_l2,_c2,_o2,_t2,_h1,_l1,_c1,_o1,_t1,_h0,_l0,_c0,_o0,_t0,up1,dw1,_l1t,_h1t] 
f_text(string _tf)=>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm'  :
     str.tonumber(_tf) > 59  ? 'h'+ str.tostring(math.floor(str.tonumber(_tf)/60))    : _tf
    _text := _tf == "1D" ? "D" : _tf == "1W" ? "W" : _tf == "1M" ? "M" : _text    
Getcolor_candle(_o,_c)=>
    clr = _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr
    clr
f_plot_candle(_c,_o,_h,_l,start,i,txt)=>
    dxx =dx
    nn = num_candles
    m = nn - i
    bl0=box.new(left=bar_index+start+dxx+ 0 + m * 3  ,top= _c , right= bar_index+start + dxx + 2 + m * 3 , bottom = _o  , bgcolor = Getcolor_candle(_o,_c), border_color = brd_clr , text = txt , text_size = i_font ,text_valign = text.align_center , text_halign = text.align_center ,text_color = color.white)
    wup=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _h , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.max(_o,_c)  , border_color = brd_clr,border_width =1)
    wdw=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _l , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.min(_o,_c) , border_color = brd_clr,border_width =1)
    box.delete(bl0[1])
    box.delete(wup[1])    
    box.delete(wdw[1]) 
///////////////////////////////////////////
RemainingTime(_TF) =>
    if barstate.isrealtime
        timeRemaining = (_TF - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        r = str.tostring(seconds, '00')
        if minutes == 0
            r:= str.tostring(minutes, '00') + ':' + r
            r
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
            r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
            r
        if days > 0
            r := str.tostring(days) + 'D ' + r
            r
        r

    else
        'Market closed' 

var tablo3 = table.new(position = position.bottom_center,columns = 2,rows = 11,frame_color=i_textcolor,frame_width=2,border_color=i_textcolor,border_width=1)
if not str.contains(syminfo.tickerid,"replay")and show_rm and tipo != "futures"
    table.cell(tablo3,0,0,text="TF: " + RemainingTime(time_close(tf)) + " [" + (is_forex ? "Forex" : "Indices") + "]" ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = i_font,text_formatting = text.format_bold)


///////////////////////////////////
var TWO = open , var TDO = open, TSO = open , var TMSO = open
var TWOt = time, var TDOt = time, var TSOt = time, var TMSOt = time
var boxW = array.new_box(),var boxD = array.new_box(),var boxN = array.new_box(),var boxm = array.new_box()
var lblW = array.new_label(),var lblD = array.new_label(),var lblN = array.new_label(),var lblm = array.new_label()
get_range(session, session_name, session_css,show,nn)=>
    var t = 0 
    var max = high
    var min = low
    var box bx = na
    var label lbl = na 
    show_txt = show 
    if session > session[1]
        t := time
        max := high
        min := low
        bx := box.new(n, max, n, min
         , bgcolor = color.new(session_css, bg_transp)
         , border_color = show_outline ? session_css : na
         , border_style = line.style_dotted)
        if show_txt
            lbl := label.new(t, max, session_name
             , xloc = xloc.bar_time
             , textcolor = session_css
             , style = label.style_label_down
             , color = color.new(color.white, 100)
             , size = i_font )

        if nn==4 and show_last
            add_to_array(boxm,bx)
            add_to_array(lblm,lbl)            
        if nn==3 and show_last
            add_to_array(boxN,bx)
            add_to_array(lblN,lbl)            
        if nn==2 and show_last
            add_to_array(boxD,bx)
            add_to_array(lblD,lbl)            
        if nn==1 and show_last
            add_to_array(boxW,bx)
            add_to_array(lblW,lbl)           
    if session==1 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, n, min)
        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)

    if show_last and nn==4 and array.size(boxm) > num_cycle
        dbox = array.get(boxm,num_cycle)
        dlbl = array.get(lblm,num_cycle)
        array.remove(boxm,num_cycle)
        array.remove(lblm,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl) 
    if show_last and nn==3 and array.size(boxN) > num_cycle
        dbox = array.get(boxN,num_cycle)
        dlbl = array.get(lblN,num_cycle)
        array.remove(boxN,num_cycle)
        array.remove(lblN,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl) 
    if show_last and nn==2 and array.size(boxD) > num_cycle
        dbox = array.get(boxD,num_cycle)
        dlbl = array.get(lblD,num_cycle)
        array.remove(boxD,num_cycle)
        array.remove(lblD,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl)
    if show_last and nn==1 and array.size(boxW) > num_cycle
        dbox = array.get(boxW,num_cycle)
        dlbl = array.get(lblW,num_cycle)
        array.remove(boxW,num_cycle)
        array.remove(lblW,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl)  
f_asline(w)=>
    sep_clr = w == 2 ? sep_clrD : w == 3 ? sep_clrW : w== 1 ? sep_clrN : sep_clrm
    //if _isses != _isses[1]
    line.new(x1 =time ,y1 = open , x2 = time, y2= open+syminfo.mintick,xloc=xloc.bar_time,color=sep_clr,style=line.style_dashed,extend=extend.both,width=1)

get_dfr(session, session_name, session_css,show,nn)=>
    var t = 0 
    var max = high
    var min = low
    var line bxh = na
    var line bxl = na
    var label lbl = na 

    show_txt = show
            
    if session > session[1]
      
        t := time
        max := high
        min := low
        bxh := line.new(t, max, t, max
         , xloc  = xloc.bar_time
         , color = session_css 
         , style = line.style_dotted
         , width =2 )
        bxl := line.new(t, min, t, min
         , xloc  = xloc.bar_time
         , color = session_css 
         , style = line.style_dotted
         , width = 2 ) 

        if show_txt
            lbl := label.new(t, max, session_name
             , xloc = xloc.bar_time
             , textcolor = session_css
             , style = label.style_label_down
             , color = color.new(color.white, 100)
             , size = i_font )
        

    if session==1 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        line.set_y1(bxh, max)
        line.set_y2(bxh, max)
        line.set_x2(bxh,time)
        line.set_y1(bxl, min)
        line.set_y2(bxl, min)
        line.set_x2(bxl,time)                       
        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)
            
        dr  = max - min
        dp1 = max + dr , dp2 = max + 2 * dr , dp2_5 = max + 2.5 * dr , dp4 = max + 4 * dr       
        dn1 = min - dr , dn2 = min - 2 * dr , dn2_5 = min - 2.5 * dr , dn4 = min - 4 * dr
 
        dp1_ln = box.new(left= t , top = dp1, right = time, bottom = dp1 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "1", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp1_ln[1])
        dp2_ln = box.new(left= t , top = dp2, right = time, bottom = dp2 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "2", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp2_ln[1])
        dp2_5_ln = box.new(left= t , top = dp2_5, right = time, bottom = dp2_5 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "2.5", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp2_5_ln[1])
        dp4_ln = box.new(left= t , top = dp4, right = time, bottom = dp4 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "4", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp4_ln[1])

        dn1_ln = box.new(left= t , top = dn1, right = time, bottom = dn1 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-1", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn1_ln[1])
        dn2_ln = box.new(left= t , top = dn2, right = time, bottom = dn2 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-2", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn2_ln[1])
        dn2_5_ln = box.new(left= t , top = dn2_5, right = time, bottom = dn2_5 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-2.5", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn2_5_ln[1])
        dn4_ln = box.new(left= t , top = dn4, right = time, bottom = dn4 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-4", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn4_ln[1])
   

//////////////////////////////////////////////////////////////////////////////////////////
arrtfok   = array.from((show_candlesmic and tf_ok_mic and tf_ok_mic_V) ,(show_candles90  and tf_ok and tf_ok_V), 
 (show_candlesD   and tf_okD and tf_okD_V), (show_candlesW   and tf_okW and tf_okW_V ))          
arrstart  = array.from(0, 0, 0, 0)
f_start()=>
    for i = 0 to 3
        array.set(arrstart,i,0)
    j = 0
    for i= 0 to 3
        if array.get(arrtfok,i) == true
            array.set(arrstart,i,j * 22)
            j := j + 1
//-----------------------------------------------------------------------------}
