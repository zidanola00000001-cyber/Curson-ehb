n = bar_index
tf = timeframe.period
sym = syminfo.tickerid
tipo = syminfo.type

// Auto-detect if Forex (starts at 17:00) or Indices/Dollar (starts at 18:00)
is_forex = syminfo.type == "forex" or str.contains(syminfo.ticker, "USD") or str.contains(syminfo.ticker, "EUR") or str.contains(syminfo.ticker, "GBP") or str.contains(syminfo.ticker, "JPY") or str.contains(syminfo.ticker, "AUD") or str.contains(syminfo.ticker, "NZD") or str.contains(syminfo.ticker, "CAD") or str.contains(syminfo.ticker, "CHF")
// Use 17:00 for forex, 18:00 for indices/dollar
cycle_start_hour = is_forex ? "17" : "18"

