//@version=6
indicator("CISD [TakingProphets] — Fixed + ICT Displacement", overlay=true)

// ── Inputs
groupVis = "Visual"
showLabels   = input.bool(true, "Show Labels", group=groupVis)
lineColor    = input.color(color.black, "CISD Line Color", group=groupVis)
textColor    = input.color(color.black, "Label Color", group=groupVis)
lineWidth    = input.int(2, "Line Width", minval=1, maxval=4, group=groupVis)
lineStyleInp = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=groupVis)
lineLength   = input.int(15, "Line Extension (bars)", minval=5, maxval=100, group=groupVis)
labelSizeInp = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Large"], group=groupVis)
keepOnlyLatest = input.bool(true, "Keep Only Latest CISD", group=groupVis)

groupLogic = "ICT Logic"
swingStrength = input.int(3, "Swing Strength (BSL/SSL pivots)", minval=2, maxval=10, group=groupLogic)
confirmMode   = input.string("FVG", "Displacement Confirm", options=["FVG","ATR","None"], group=groupLogic)
atrLen        = input.int(14, "ATR Length", group=groupLogic)
atrMult       = input.float(1.0, "ATR Multiplier", step=0.1, group=groupLogic)

groupRetest = "Retest Alerts"
retestEnabled = input.bool(true, "Enable Retest Alerts", group=groupRetest)
retestBars    = input.int(20, "Retest Window (bars)", minval=1, maxval=200, group=groupRetest)
retestPct     = input.float(0.05, "Touch Tolerance (% of price)", step=0.01, group=groupRetest)

// ── Helpers
getLabelSize() =>
    switch labelSizeInp
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

chosenStyle = switch lineStyleInp
    "Solid" => line.style_solid
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

inBull() => close > open
inBear() => close < open

hasBullFVG() => not na(high[2]) and low > high[2]
hasBearFVG() => not na(low[2]) and high < low[2]

displacementOkBull() =>
    confirmMode == "None" or
    (confirmMode == "FVG" and hasBullFVG()) or
    (confirmMode == "ATR" and math.abs(close - open) >= atrMult * ta.atr(atrLen))

displacementOkBear() =>
    confirmMode == "None" or
    (confirmMode == "FVG" and hasBearFVG()) or
    (confirmMode == "ATR" and math.abs(close - open) >= atrMult * ta.atr(atrLen))

// ── Visual state
var line[]  cisdLines  = array.new_line()
var label[] cisdLabels = array.new_label()

drawCisd(startPrice, startIndex, isBull) =>
    if keepOnlyLatest
        for i = array.size(cisdLines) - 1 to 0
            line.delete(array.get(cisdLines, i))
            array.remove(cisdLines, i)
        for i = array.size(cisdLabels) - 1 to 0
            label.delete(array.get(cisdLabels, i))
            array.remove(cisdLabels, i)
    ln = line.new(startIndex, startPrice, bar_index + lineLength, startPrice,
         color=lineColor, style=chosenStyle, width=lineWidth, extend=extend.none)
    array.push(cisdLines, ln)
    if showLabels
        lb = label.new(bar_index + 2, startPrice, isBull ? "CISD+" : "CISD-",
             style=label.style_none, textcolor=textColor, size=getLabelSize(), textalign=text.align_left)
        array.push(cisdLabels, lb)
    [ln]

// ── Sequence tracking (fixed: separate bull/bear state)
var int   bullCount = 0
var float bullFirstOpen = na
var int   bullFirstIndex = na

var int   bearCount = 0
var float bearFirstOpen = na
var int   bearFirstIndex = na

if barstate.isconfirmed
    bool bullNow = inBull()
    bool bearNow = inBear()
    bool bullPrev = close[1] > open[1]
    bool bearPrev = close[1] < open[1]

    // Bullish run
    if bullNow
        if not bullPrev
            bullCount := 1
            bullFirstOpen := open
            bullFirstIndex := bar_index
        else
            bullCount += 1
    else
        bullCount := 0
        bullFirstOpen := na
        bullFirstIndex := na

    // Bearish run
    if bearNow
        if not bearPrev
            bearCount := 1
            bearFirstOpen := open
            bearFirstIndex := bar_index
        else
            bearCount += 1
    else
        bearCount := 0
        bearFirstOpen := na
        bearFirstIndex := na

// ── Liquidity levels via pivots (store recent; sweep when taken)
var float[] bslPrices = array.new_float()
var float[] sslPrices = array.new_float()

ph = ta.pivothigh(swingStrength, swingStrength)
pl = ta.pivotlow(swingStrength, swingStrength)

if not na(ph)
    array.push(bslPrices, ph)
if not na(pl)
    array.push(sslPrices, pl)

bslSwept = false
sslSwept = false

if array.size(bslPrices) > 0
    for i = array.size(bslPrices) - 1 to 0
        if high > array.get(bslPrices, i)
            bslSwept := true
            array.remove(bslPrices, i)
            break

if array.size(sslPrices) > 0
    for i = array.size(sslPrices) - 1 to 0
        if low < array.get(sslPrices, i)
            sslSwept := true
            array.remove(sslPrices, i)
            break

// ── Sweep → wait for opposite displacement through sequence-start open
var bool  waiting = false
var bool  wantBull = false
var float seqStartPrice = na
var int   seqStartIndex = na

if barstate.isconfirmed and not waiting
    if bslSwept and not na(bullFirstOpen)
        waiting := true
        wantBull := false  // after BSL sweep we want bearish displacement
        seqStartPrice := bullFirstOpen
        seqStartIndex := bullFirstIndex
    if sslSwept and not na(bearFirstOpen)
        waiting := true
        wantBull := true   // after SSL sweep we want bullish displacement
        seqStartPrice := bearFirstOpen
        seqStartIndex := bearFirstIndex

var bool cisdBullFormed = false
var bool cisdBearFormed = false
var line lastCisdLine = na

cisdBullFormed := false
cisdBearFormed := false

if waiting
    if wantBull and close > seqStartPrice and displacementOkBull()
        [lastCisdLine] = drawCisd(seqStartPrice, seqStartIndex, true)
        cisdBullFormed := true
        waiting := false
    if not wantBull and close < seqStartPrice and displacementOkBear()
        [lastCisdLine] = drawCisd(seqStartPrice, seqStartIndex, false)
        cisdBearFormed := true
        waiting := false

// ── Retest alerts
var bool  waitingRetest = false
var bool  retestIsBull  = false
var float retestPx      = na
var int   retestUntil   = na

if retestEnabled and (cisdBullFormed or cisdBearFormed) and not na(lastCisdLine)
    waitingRetest := true
    retestIsBull  := cisdBullFormed
    retestPx      := line.get_y1(lastCisdLine)
    retestUntil   := bar_index + retestBars

retestTouched = false
retestConfirmed = false
tolAbs = retestPx * (retestPct / 100.0)

if waitingRetest
    if bar_index <= retestUntil
        if retestIsBull
            retestTouched := low <= retestPx + tolAbs
            retestConfirmed := retestTouched and close > retestPx
        else
            retestTouched := high >= retestPx - tolAbs
            retestConfirmed := retestTouched and close < retestPx
        if retestConfirmed
            waitingRetest := false
    else
        waitingRetest := false

// ── Alerts
alertcondition(cisdBullFormed, "CISD+ formed", "CISD+ (bullish) formed after SSL sweep.")
alertcondition(cisdBearFormed, "CISD- formed", "CISD- (bearish) formed after BSL sweep.")
alertcondition(retestConfirmed and retestIsBull, "CISD+ retest", "Bullish CISD retest confirmed.")
alertcondition(retestConfirmed and not retestIsBull, "CISD- retest", "Bearish CISD retest confirmed.")

// ── Maintain visuals
if barstate.islast and array.size(cisdLines) > 0
    for i = 0 to array.size(cisdLines) - 1
        ln = array.get(cisdLines, i)
        line.set_x2(ln, line.get_x1(ln) + lineLength)

